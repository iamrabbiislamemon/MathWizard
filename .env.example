# Copy to .env.local and fill in the values:  cp .env.example .env.local

# Personal access token used to read the Markdown files.
#   Fine-grained (recommended): github.com/settings/personal-access-tokens → Generate new token
#     → Repository access: only the content repository → Permissions: Contents → Read-only.
#   Classic: the `repo` scope for a private repository; no scope is needed for a public one.
# Optional for public repositories, but unauthenticated requests are limited to 60 per hour.
GITHUB_TOKEN=

# The content repository: https://github.com/<GITHUB_OWNER>/<GITHUB_REPO>
GITHUB_OWNER=
GITHUB_REPO=

# Branch to read pages from. Pushes to other branches are ignored by the webhook.
GITHUB_BRANCH=main

# Server deployments only: signs the push notifications sent to /api/revalidate.
# Generate one with:  openssl rand -hex 32
# Give the same value to whichever sends them:
#   - the content repository's workflow (content-repo/.github/workflows/publish-site.yml),
#     as its WEBHOOK_SECRET secret, or
#   - a repository webhook (Settings → Webhooks → Add webhook), with Payload URL
#     https://<your-domain>/api/revalidate, Content type application/json, this value as
#     the Secret, and "Just the push event". Walkthrough in app/api/revalidate/route.js.
WEBHOOK_SECRET=

# Optional: folder in the repository that holds the .md files (default: repository root).
# With GITHUB_CONTENT_DIR=content, the URL /hello-world renders content/hello-world.md.
# GITHUB_CONTENT_DIR=content

# Optional: API URL for GitHub Enterprise Server, e.g. https://github.example.com/api/v3
# GITHUB_API_URL=

# The GitHub Pages workflow (.github/workflows/deploy-pages.yml) sets these for its build;
# a server doesn't need them. To preview that build locally: STATIC_EXPORT=true npm run build
# STATIC_EXPORT=true
# PAGES_BASE_PATH=/your-repository
